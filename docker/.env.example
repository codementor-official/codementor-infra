# Copy to .env on the target host. Never commit the real values.

COMPOSE_PROJECT_NAME=codementor-dev

POSTGRES_USER=codementor
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=codementor
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-different-strong-password
KEYCLOAK_DB_NAME=keycloak

MONGO_USER=codementor
MONGO_PASSWORD=replace-with-a-strong-password
MONGO_DB=codementor
MONGO_BIND_ADDRESS=127.0.0.1
MONGO_PORT=27017

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-strong-admin-password
KEYCLOAK_HTTP_PORT=8080

# JSON arrays consumed by configure-codementor-realm.sh.
KEYCLOAK_ADMIN_REDIRECT_URIS=["http://localhost:3002/*"]
KEYCLOAK_ADMIN_WEB_ORIGINS=["http://localhost:3002"]

# Generated on the target host by configure-codementor-realm.sh. Never commit real values.
KEYCLOAK_USER_SERVICE_CLIENT_SECRET=
KEYCLOAK_AI_AGENT_CLIENT_SECRET=
KEYCLOAK_DEV_STUDENT_PASSWORD=
KEYCLOAK_DEV_LECTURER_PASSWORD=
KEYCLOAK_DEV_ADMIN_PASSWORD=
