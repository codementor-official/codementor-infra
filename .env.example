# Copy to .env on the target host. Never commit the real values.

COMPOSE_PROJECT_NAME=codementor-dev

POSTGRES_USER=codementor
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=codementor
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-different-strong-password
KEYCLOAK_DB_NAME=keycloak

MONGO_USER=codementor
MONGO_PASSWORD=replace-with-a-strong-password
MONGO_DB=codementor
MONGO_BIND_ADDRESS=127.0.0.1
MONGO_PORT=27017

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-strong-admin-password
KEYCLOAK_HTTP_PORT=8080
# Public HTTPS hostname, fronted by Nginx + Let's Encrypt on the host. Keycloak
# only listens on 127.0.0.1:8080 now — this is the one address anything external
# (browsers, apps) should ever use to reach it.
KEYCLOAK_HOSTNAME=https://id.codementor.cloud

# JSON arrays consumed by configure-codementor-realm.sh.
# 3010/3011, not 3001-3009 — that range belongs to the backend services (see
# codementor-backend/docs/02-service-architecture.md). Frontend apps live at 3010+.
KEYCLOAK_ADMIN_REDIRECT_URIS=["http://localhost:3011/*","http://13.214.122.227:3011/*"]
KEYCLOAK_ADMIN_WEB_ORIGINS=["http://localhost:3011","http://13.214.122.227:3011"]
KEYCLOAK_LECTURER_REDIRECT_URIS=["http://localhost:3010/*","http://13.214.122.227:3010/*"]
KEYCLOAK_LECTURER_WEB_ORIGINS=["http://localhost:3010","http://13.214.122.227:3010"]

# Generated on the target host by configure-codementor-realm.sh. Never commit real values.
KEYCLOAK_USER_SERVICE_CLIENT_SECRET=
KEYCLOAK_AI_AGENT_CLIENT_SECRET=
KEYCLOAK_DEV_STUDENT_PASSWORD=
KEYCLOAK_DEV_LECTURER_PASSWORD=
KEYCLOAK_DEV_ADMIN_PASSWORD=

# Social login (Google/Facebook OAuth apps). Leave both blank to skip provisioning
# that identity provider — configure-codementor-realm.sh no-ops on missing ones.
# Authorized redirect URI to register on each console:
#   Google:   https://id.codementor.cloud/realms/codementor/broker/google/endpoint
#   Facebook: https://id.codementor.cloud/realms/codementor/broker/facebook/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
